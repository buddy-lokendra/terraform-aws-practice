{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformCloudWatchCleanup",
      "Effect": "Allow",
      "Action": [
        "logs:DeleteLogStream",
        "logs:DeleteLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:820986827992:log-group:/terraform/practice/app",
        "arn:aws:logs:us-east-1:820986827992:log-group:/terraform/practice/app:log-stream:application-stream"
      ]
    }
  ]
}
